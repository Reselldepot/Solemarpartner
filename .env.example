# Kopieren nach ".env" und mit echten Werten füllen. ".env" niemals committen.

# --- Mailchimp -----------------------------------------------------------
# API-Key: Mailchimp -> Account -> Extras -> API keys
MAILCHIMP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-us21
# Der Teil nach dem Bindestrich im API-Key, z.B. "us21"
MAILCHIMP_SERVER_PREFIX=us21
# Audience/List-ID: Mailchimp -> Audience -> Settings -> Audience name and defaults
MAILCHIMP_AUDIENCE_ID=xxxxxxxxxx

# --- SMTP für persönliche Erstansprache (send_outreach.py) --------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=partner@solemarperfume.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
SMTP_FROM_NAME=SOLÉMAR Partnerprogramm
SMTP_FROM_EMAIL=partner@solemarperfume.com
# Test-Modus: an diese Adresse gehen ALLE Mails statt an echte Empfänger
SMTP_TEST_OVERRIDE_TO=
